<!DOCTYPE html>
<html>
<head>
  <title>Employee Leave History</title>
  <style>
    body { font-family: Arial; margin: 0; background: #f4f6f8; }
    header { background: #2c3e50; color: white; padding: 15px 30px; }
    nav { background: #34495e; padding: 10px 30px; }
    nav a { color: white; margin-right: 15px; text-decoration: none; font-size: 14px; }
    .container { max-width: 100%; margin: 30px auto; padding: 20px; background: white; border-radius: 8px; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 13px; }
    th, td { padding: 8px; border: 1px solid #ddd; text-align: center; }
    th { background: #2c3e50; color: white; }
    .table-title { background: #ecf0f1; font-weight: bold; text-align: left; }
  </style>
</head>
<body>
  <header><h1>🚜 Nourish Farm Management</h1></header>
  <nav>
    <a href="/">Home</a>
    <a href="/leave/dashboard">Leave Dashboard</a>
    <a href="/leave/policy">Leave Policy</a>
    <a href="/leave/history">Employee Leave History</a>
    <a href="/leave/apply">Apply for Leave</a>
    <a href="/leave/applications">Leave Applications</a>
  </nav>
  <div class="container">
    <h2>📋 Employee Leave History (Year: <%= year %>)</h2>
    
    <form method="GET" action="/leave/history">
      <input type="text" name="q" value="<%= query %>" placeholder="Enter Employee ID or Name" style="padding: 8px; width: 300px;" required />
      <input type="number" name="year" value="<%= year %>" style="padding: 8px; width: 100px;" />
      <button type="submit" style="padding: 8px 15px; background: #2980b9; color: white; border: none; border-radius: 4px;">Search</button>
    </form>

    <% if (employee) { %>
      <div style="margin-top: 20px; background: #ecf0f1; padding: 15px; border-radius: 5px;">
        <h3 style="margin: 0 0 10px 0;"><%= employee.employeeName %> (<%= employee.employeeId || 'Pending ID' %>)</h3>
        <p style="margin: 0;">Designation: <%= employee.designation %> | Department: <%= employee.department %> | Farm: <%= employee.farmName %> | Joining Date: <%= employee.joiningDate %></p>
      </div>

      <!-- HORIZONTAL LEAVE BALANCE TABLE -->
      <h3 style="margin-top: 30px;">Yearly Leave Balance</h3>
      <table>
        <thead>
          <tr>
            <th style="text-align: left;">Particulars</th>
            <th>Project Casual Leave</th>
            <th>Casual Leave</th>
            <th>Medical Leave</th>
            <th>Marriage Leave</th>
            <th>Paternity Leave</th>
            <th>Hajj Leave</th>
            <th>Omrah Leave</th>
            <th>Bereavement Leave</th>
            <th>Earn Leave</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="table-title">Annual Entitlement</td>
            <% ['Project Casual Leave', 'Casual Leave', 'Medical Leave', 'Marriage Leave', 'Paternity Leave', 'Hajj Leave', 'Omrah Leave', 'Bereavement Leave', 'Earn Leave'].forEach(lt => { %>
              <td><%= balances[lt].entitlement %></td>
            <% }); %>
          </tr>
          <tr>
            <td class="table-title">Previous Year Carry Forward</td>
            <% ['Project Casual Leave', 'Casual Leave', 'Medical Leave', 'Marriage Leave', 'Paternity Leave', 'Hajj Leave', 'Omrah Leave', 'Bereavement Leave', 'Earn Leave'].forEach(lt => { %>
              <td><%= balances[lt].carryForward %></td>
            <% }); %>
          </tr>
          <tr>
            <td class="table-title">Total Used Leave</td>
            <% ['Project Casual Leave', 'Casual Leave', 'Medical Leave', 'Marriage Leave', 'Paternity Leave', 'Hajj Leave', 'Omrah Leave', 'Bereavement Leave', 'Earn Leave'].forEach(lt => { %>
              <td><%= balances[lt].used %></td>
            <% }); %>
          </tr>
          <tr style="background: #e8f8f5; font-weight: bold;">
            <td class="table-title">Remaining Balance</td>
            <% ['Project Casual Leave', 'Casual Leave', 'Medical Leave', 'Marriage Leave', 'Paternity Leave', 'Hajj Leave', 'Omrah Leave', 'Bereavement Leave', 'Earn Leave'].forEach(lt => { %>
              <td><%= balances[lt].remaining %></td>
            <% }); %>
          </tr>
        </tbody>
      </table>

      <h3 style="margin-top: 30px;">Leave Application History</h3>
      <table>
        <thead>
          <tr>
            <th>SL</th><th>App ID</th><th>Date</th><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th><th>Bal Before</th><th>Bal After</th>
          </tr>
        </thead>
        <tbody>
          <% history.forEach((h, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= h._id %></td>
              <td><%= new Date(h.applicationDate).toLocaleDateString('en-GB') %></td>
              <td><%= h.leaveType %></td>
              <td><%= new Date(h.fromDate).toLocaleDateString('en-GB') %></td>
              <td><%= new Date(h.toDate).toLocaleDateString('en-GB') %></td>
              <td><%= h.totalDays %></td>
              <td><%= h.reason %></td>
              <td><%= h.status %></td>
              <td><%= h.balanceBefore %></td>
              <td><%= h.balanceAfter %></td>
            </tr>
          <% }); %>
          <% if(history.length === 0) { %>
            <tr><td colspan="11">No leave applications found for this year.</td></tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>