<!DOCTYPE html>
<html>
<head>
  <title>Leave Dashboard</title>
  <style>
    body { font-family: Arial; margin: 0; background: #f4f6f8; }
    header { background: #2c3e50; color: white; padding: 15px 30px; }
    nav { background: #34495e; padding: 10px 30px; }
    nav a { color: white; margin-right: 15px; text-decoration: none; font-size: 14px; }
    nav a:hover { color: #1abc9c; }
    .container { max-width: 1100px; margin: 30px auto; padding: 20px; background: white; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05); }
    .card-container { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px; }
    .card { background: #e8f8f5; padding: 20px; border-radius: 8px; border-left: 5px solid #1abc9c; flex: 1; min-width: 200px; }
    .card h3 { margin: 0 0 10px 0; color: #34495e; font-size: 16px; }
    .card p { margin: 0; font-size: 24px; font-weight: bold; color: #16a085; }
  </style>
</head>
<body>
  <header><h1>🚜 Nourish Farm Management</h1></header>
  <nav>
    <a href="/">Home</a>
    <a href="/leave/dashboard">Leave Dashboard</a>
    <a href="/leave/policy">Leave Policy</a>
    <a href="/leave/history">Employee Leave History</a>
    <a href="/leave/apply">Apply for Leave</a>
    <a href="/leave/applications">Leave Applications</a>
  </nav>
  <div class="container">
    <h2>📊 Employee Leave Database-Yearly (Dashboard)</h2>
    <form method="GET" action="/leave/dashboard">
      <label>Select Year: </label>
      <input type="number" name="year" value="<%= year %>" style="padding: 5px; width: 100px;" />
      <button type="submit" style="padding: 5px 15px; background: #2980b9; color: white; border: none; border-radius: 4px;">Filter</button>
    </form>

    <div class="card-container">
      <div class="card">
        <h3>Total Active Employees</h3>
        <p><%= activeEmployees %></p>
      </div>
      <div class="card" style="border-left-color: #3498db; background: #ebf5fb;">
        <h3>Total Applications</h3>
        <p style="color: #2980b9;"><%= totalApps %></p>
      </div>
      <div class="card" style="border-left-color: #f39c12; background: #fef5e7;">
        <h3>Submitted Applications</h3>
        <p style="color: #d35400;"><%= submittedApps %></p>
      </div>
      <div class="card" style="border-left-color: #e74c3c; background: #fdedec;">
        <h3>Total Leave Days Deducted</h3>
        <p style="color: #c0392b;"><%= totalDeducted %></p>
      </div>
    </div>
  </div>
</body>
</html>