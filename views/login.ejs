<!DOCTYPE html>
<html>
<head>
  <title>Login - Nourish Farm</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; margin: 0; background: #F4F8F5; display: flex; align-items: center; justify-content: center; height: 100vh; background-image: url('https://drive.google.com/thumbnail?id=1_jXrw-fzIZG46YSGZexWUeirGTrm4r2t&sz=w1000'); background-size: cover; background-position: center; }
    .login-box { background: white; padding: 40px; border-radius: 12px; width: 350px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border-top: 5px solid #087A45; }
    h2 { text-align: center; color: #087A45; margin-bottom: 30px; font-size: 22px; }
    input, button { width: 100%; padding: 12px; margin: 8px 0; box-sizing: border-box; border-radius: 8px; border: 1px solid #E1EBE4; font-family: 'Inter', sans-serif; }
    input:focus { outline: none; border-color: #087A45; box-shadow: 0 0 0 3px rgba(8, 122, 69, 0.1); }
    button { background: linear-gradient(135deg, #087A45 0%, #10A66A 100%); color: white; border: none; font-size: 16px; cursor: pointer; font-weight: 600; margin-top: 15px; }
    button:hover { opacity: 0.9; }
    .error { color: #e74c3c; text-align: center; font-size: 14px; margin-bottom: 10px; background: #fdedec; padding: 10px; border-radius: 5px; }
  </style>
</head>
<body>
  <div class="login-box">
    <div style="text-align: center; margin-bottom: 20px;">
      <img src="https://drive.google.com/thumbnail?id=11cZ9XubuEhk-jwMg07F5ydAMzAHiL1kO&sz=w500" alt="Logo" style="width: 80px; border-radius: 10px;">
    </div>
    <h2>Nourish Farm Login</h2>
    <% if(error) { %><div class="error"><%= error %></div><% } %>
    <form action="/login" method="POST">
      <input type="text" name="employeeId" placeholder="Employee ID" required />
      <input type="password" name="password" placeholder="Password" required />
      <button type="submit">Login to System</button>
    </form>
  </div>
</body>
</html>